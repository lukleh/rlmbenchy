{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rlmbenchy.local/schemas/otel-log-v1.schema.json",
  "title": "rlmbenchy OpenTelemetry-shaped JSONL record v1",
  "description": "One line in an rlmbenchy telemetry JSONL file. The schema fixes the shared envelope and signal-specific structure while leaving event-specific payloads extensible.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_name",
    "schema_version",
    "record_type",
    "record_id",
    "seq",
    "run_id",
    "trace_id",
    "resource",
    "scope"
  ],
  "properties": {
    "schema_name": {
      "const": "rlmbenchy_otel"
    },
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "enum": ["log", "span", "metric"]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "resource": {
      "type": "object",
      "required": ["service.name"],
      "properties": {
        "service.name": {
          "type": "string",
          "minLength": 1
        },
        "service.version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "const": "rlmbenchy.rlm"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "unixNano": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "domainBody": {
      "type": "object",
      "required": ["data", "stats", "summary"],
      "properties": {
        "data": {
          "type": "object"
        },
        "stats": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "log"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "event_seq",
          "time",
          "time_unix_nano",
          "observed_time",
          "observed_time_unix_nano",
          "span_id",
          "severity_text",
          "severity_number",
          "event_name",
          "body",
          "attributes"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_seq": {
            "type": "integer",
            "minimum": 1
          },
          "time": {
            "$ref": "#/$defs/timestamp"
          },
          "time_unix_nano": {
            "$ref": "#/$defs/unixNano"
          },
          "observed_time": {
            "$ref": "#/$defs/timestamp"
          },
          "observed_time_unix_nano": {
            "$ref": "#/$defs/unixNano"
          },
          "span_id": {
            "type": "string"
          },
          "severity_text": {
            "type": "string",
            "minLength": 1
          },
          "severity_number": {
            "type": "integer"
          },
          "event_name": {
            "type": "string",
            "pattern": "^rlmbenchy\\."
          },
          "body": {
            "$ref": "#/$defs/domainBody"
          },
          "attributes": {
            "allOf": [
              {
                "$ref": "#/$defs/attributes"
              },
              {
                "required": [
                  "rlmbenchy.event_type",
                  "rlmbenchy.event_id",
                  "rlmbenchy.event_seq",
                  "rlmbenchy.run_id",
                  "rlmbenchy.log.schema_version",
                  "rlmbenchy.data",
                  "rlmbenchy.stats",
                  "rlmbenchy.summary"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "span"
          }
        }
      },
      "then": {
        "required": [
          "span_id",
          "parent_span_id",
          "name",
          "span_kind",
          "start_time",
          "start_time_unix_nano",
          "end_time",
          "end_time_unix_nano",
          "status",
          "attributes",
          "events"
        ],
        "properties": {
          "span_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "parent_span_id": {
            "type": ["string", "null"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "span_kind": {
            "enum": ["INTERNAL", "SERVER", "CLIENT", "PRODUCER", "CONSUMER"]
          },
          "start_time": {
            "$ref": "#/$defs/timestamp"
          },
          "start_time_unix_nano": {
            "$ref": "#/$defs/unixNano"
          },
          "end_time": {
            "$ref": "#/$defs/timestamp"
          },
          "end_time_unix_nano": {
            "$ref": "#/$defs/unixNano"
          },
          "status": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "enum": ["UNSET", "OK", "ERROR"]
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "attributes": {
            "$ref": "#/$defs/attributes"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "time", "time_unix_nano", "attributes"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "time": {
                  "$ref": "#/$defs/timestamp"
                },
                "time_unix_nano": {
                  "$ref": "#/$defs/unixNano"
                },
                "attributes": {
                  "$ref": "#/$defs/attributes"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "metric"
          }
        }
      },
      "then": {
        "required": [
          "time",
          "time_unix_nano",
          "name",
          "description",
          "unit",
          "instrument_type",
          "value",
          "attributes"
        ],
        "properties": {
          "time": {
            "$ref": "#/$defs/timestamp"
          },
          "time_unix_nano": {
            "$ref": "#/$defs/unixNano"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "instrument_type": {
            "enum": ["gauge", "histogram", "sum"]
          },
          "value": {
            "type": ["number", "integer"]
          },
          "attributes": {
            "$ref": "#/$defs/attributes"
          }
        }
      }
    }
  ]
}
